FROM node:25-alpine AS build

RUN apk upgrade --no-cache zlib

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:stable-alpine-slim

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

USER root

# Atualiza zlib para corrigir CVE-2026-22184 (buffer overflow no utilitário untgz).
# A imagem base nginx:stable-alpine-slim usa zlib 1.3.1-r2; a versao corrigida e 1.3.2-r0.
RUN apk upgrade --no-cache zlib && \
    apk add --no-cache openssl

COPY scripts/start-nginx.sh /usr/local/bin/start-nginx.sh
RUN chmod +x /usr/local/bin/start-nginx.sh

USER nginx

EXPOSE 8443

CMD ["/usr/local/bin/start-nginx.sh"]
