{
  "name": "conciliacao-financeira",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix backend\" \"node scripts/start-frontend-dev.mjs\"",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:release": "node scripts/build-release.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "zip:portable": "node scripts/zip-portable.mjs",
    "release:portable": "npm run build:portable && npm run zip:portable",
    "docker:up": "node scripts/docker-up.mjs dev",
    "docker:up:prod": "node scripts/docker-up.mjs prod",
    "docker:down": "docker compose --profile dev --profile prod down --remove-orphans",
    "docker:down:volumes": "docker compose down -v --remove-orphans",
    "docker:logs": "docker compose --profile dev --profile prod logs -f",
    "docker:healthcheck": "node scripts/healthcheck.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  },
  "version": "2.1.1"
}
