    "scripts": {
        "build": "tsc -p tsconfig.json && tsc -p tsconfig.seed.json",
        "test": "tsc --noEmit -p tsconfig.json",
        "dev": "nodemon --watch src --ext ts --exec \"ts-node --transpile-only src/index.ts\"",
        "start": "node dist/index.js",
        "seed": "ts-node --transpile-only prisma/seed.ts",
        "seed:compiled": "node dist/prisma/seed.js",
        "db:migrate": "prisma migrate deploy",
        "start:docker": "node dist/index.js"
    },
